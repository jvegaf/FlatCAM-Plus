#!/bin/bash

# Launcher for a source checkout or a `make install` tree. The application lives in the
# `flatcam_plus` package, so the repository (or install) root goes on PYTHONPATH and the package
# module is what runs.
script_path=$(readlink -f "$0")
python_script_path=$(dirname "$script_path")/../../../
# ``-P`` keeps the caller's current directory off ``sys.path``: ``-m`` would otherwise put it ahead
# of the PYTHONPATH entry, letting a ``flatcam_plus`` package there shadow this one.
PYTHONPATH="$python_script_path${PYTHONPATH:+:$PYTHONPATH}" python3 -P -m flatcam_plus "$@"
