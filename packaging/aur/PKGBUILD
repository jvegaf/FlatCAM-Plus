# Maintainer: Jose Vega <josevega234@gmail.com>
#
# A -bin package: the release ships a self-contained PyInstaller bundle, and the dependency set
# (Python 3.14, PyQt6 6.11, ortools, rasterio, ...) cannot be honoured by Arch's packaged
# python-* modules. Building from source here would produce a package that cannot resolve, so this
# repackages the official Linux tarball instead.
pkgname=flatcam-plus-bin
pkgver=1.3.0
pkgrel=1
pkgdesc="PCB CAM and CNC workflow (prebuilt bundle)"
arch=('x86_64')
url="https://github.com/thebestgoodguy/FlatCAM-Plus"
license=('MIT')
depends=('glibc' 'libgl' 'libxkbcommon' 'dbus' 'fontconfig' 'freetype2')
optdepends=('xdg-utils: open files and folders from the application')
provides=('flatcam-plus')
conflicts=('flatcam-plus')
# The payload is a frozen application: stripping it breaks the bundled libraries, and the bundle
# carries its own directory layout.
options=('!strip' '!emptydirs')

_release="${url}/releases/download/v${pkgver}"
_assets="${url}/raw/v${pkgver}/packaging/linux"

source=(
    "FlatCAMPlus-${pkgver}-linux-x86_64.tar.gz::${_release}/FlatCAMPlus-${pkgver}-linux-x86_64.tar.gz"
    "flatcam-plus.desktop::${_assets}/flatcam-plus.desktop"
    "flatcam-plus.metainfo.xml::${_assets}/flatcam-plus.metainfo.xml"
    "flatcam-plus.png::${url}/raw/v${pkgver}/assets/resources/app256.png"
)
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
    install -d "$pkgdir/opt/flatcam-plus"
    cp -a "$srcdir/FlatCAM-Plus/." "$pkgdir/opt/flatcam-plus/"

    # Same launcher the deb and the rpm install, so the three packages behave identically.
    install -d "$pkgdir/usr/bin"
    cat > "$pkgdir/usr/bin/flatcam-plus" <<'LAUNCHER'
#!/bin/sh
set -eu
APPDIR="${FLATCAM_PLUS_HOME:-/opt/flatcam-plus}"
if [ ! -x "$APPDIR/FlatCAM-Plus" ]; then
    echo "flatcam-plus: no executable payload at $APPDIR/FlatCAM-Plus" >&2
    exit 1
fi
exec "$APPDIR/FlatCAM-Plus" "$@"
LAUNCHER
    chmod 0755 "$pkgdir/usr/bin/flatcam-plus"

    install -Dm644 "$srcdir/flatcam-plus.desktop" \
        "$pkgdir/usr/share/applications/flatcam-plus.desktop"
    install -Dm644 "$srcdir/flatcam-plus.metainfo.xml" \
        "$pkgdir/usr/share/metainfo/flatcam-plus.metainfo.xml"
    install -Dm644 "$srcdir/flatcam-plus.png" \
        "$pkgdir/usr/share/icons/hicolor/256x256/apps/flatcam-plus.png"
}
